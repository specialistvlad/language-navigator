{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interface wording",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "description": "Wording by key, one string per explanation language.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/localized"
      }
    }
  },
  "definitions": {
    "localized": {
      "description": "Text in every explanation language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
