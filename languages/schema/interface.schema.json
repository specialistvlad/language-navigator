{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interface wording",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "errorsAudience"
  ],
  "properties": {
    "text": {
      "description": "Wording by key, one string per explanation language.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/localized"
      }
    },
    "errorsAudience": {
      "description": "Line above a Typical errors table: by explanation language, then by language being learned.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/definitions/someLanguages"
        },
        "es": {
          "$ref": "#/definitions/someLanguages"
        }
      }
    }
  },
  "definitions": {
    "localized": {
      "description": "Text in every explanation language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "someLanguages": {
      "description": "Text in some explanation languages.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
