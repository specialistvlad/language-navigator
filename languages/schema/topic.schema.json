{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "topic.schema.json",
  "title": "langs123 topic",
  "description": "One topic of one language being learned, explained in every explanation language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lang",
    "kind",
    "tags",
    "concepts",
    "related",
    "status",
    "title",
    "summary",
    "cheatsheet",
    "sections"
  ],
  "properties": {
    "id": {
      "$ref": "#/definitions/topicId"
    },
    "lang": {
      "$ref": "#/definitions/explain"
    },
    "kind": {
      "enum": [
        "grammar",
        "foundations",
        "reference"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/topicId"
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "$ref": "#/definitions/status"
        }
      }
    },
    "title": {
      "$ref": "#/definitions/localized"
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "cheatsheet": {
      "description": "Section 00: the whole topic in one table, shown in both the Cheatsheet and the Extended view.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "$ref": "#/definitions/content"
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      },
      "minItems": 1
    }
  },
  "definitions": {
    "level": {
      "description": "A level from languages/levels.yaml. Every leaf carries one; sections, cheatsheets and topics take their range from their leaves.",
      "enum": [
        "A0",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "explain": {
      "enum": [
        "en"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "topicId": {
      "type": "string",
      "pattern": "^en\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "readers": {
      "description": "Explanation languages an element serves; all when absent.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/explain"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "variety": {
      "description": "A variety of the language being learned, as a BCP 47 tag; en-GB when absent.",
      "enum": [
        "en-GB",
        "en-US"
      ]
    },
    "features": {
      "description": "The grammar features of a row, a column or a section: one bundle, or several that each apply.",
      "oneOf": [
        {
          "$ref": "#/definitions/featureBundle"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/featureBundle"
          },
          "minItems": 2
        }
      ]
    },
    "featureBundle": {
      "description": "Grammar features after the UniMorph schema; a feature takes one value or several.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "person": {
          "oneOf": [
            {
              "enum": [
                1,
                2,
                3
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "number": {
          "oneOf": [
            {
              "enum": [
                "sg",
                "pl"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "sg",
                  "pl"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "gender": {
          "oneOf": [
            {
              "enum": [
                "masc",
                "fem",
                "neut"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "masc",
                  "fem",
                  "neut"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "case": {
          "oneOf": [
            {
              "enum": [
                "nom",
                "acc",
                "gen"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "nom",
                  "acc",
                  "gen"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "tense": {
          "oneOf": [
            {
              "enum": [
                "prs",
                "pst",
                "fut"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "prs",
                  "pst",
                  "fut"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "aspect": {
          "oneOf": [
            {
              "enum": [
                "prog",
                "prf",
                "hab"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "prog",
                  "prf",
                  "hab"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "mood": {
          "oneOf": [
            {
              "enum": [
                "ind",
                "imp",
                "sbjv",
                "cond"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "ind",
                  "imp",
                  "sbjv",
                  "cond"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "polarity": {
          "oneOf": [
            {
              "enum": [
                "pos",
                "neg"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "pos",
                  "neg"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "interrogativity": {
          "oneOf": [
            {
              "enum": [
                "decl",
                "int"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "decl",
                  "int"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "politeness": {
          "oneOf": [
            {
              "enum": [
                "infm",
                "form"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "infm",
                  "form"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "degree": {
          "oneOf": [
            {
              "enum": [
                "pos",
                "cmpr",
                "sprl"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "pos",
                  "cmpr",
                  "sprl"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "definiteness": {
          "oneOf": [
            {
              "enum": [
                "def",
                "indf"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "def",
                  "indf"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "deixis": {
          "oneOf": [
            {
              "enum": [
                "prox",
                "dist"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "prox",
                  "dist"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "voice": {
          "oneOf": [
            {
              "enum": [
                "act",
                "pass"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "act",
                  "pass"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "verbform": {
          "oneOf": [
            {
              "enum": [
                "inf",
                "ptcp",
                "ger"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "inf",
                  "ptcp",
                  "ger"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "contraction": {
          "oneOf": [
            {
              "enum": [
                "full",
                "short"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "full",
                  "short"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "countability": {
          "oneOf": [
            {
              "enum": [
                "count",
                "mass"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "count",
                  "mass"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        }
      }
    },
    "text": {
      "description": "Text: a string, one mark, or a list of parts.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/mark"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/part"
          },
          "minItems": 2
        }
      ]
    },
    "part": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/definitions/mark"
        }
      ]
    },
    "mark": {
      "oneOf": [
        {
          "$ref": "#/definitions/targetMark"
        },
        {
          "$ref": "#/definitions/auxMark"
        },
        {
          "$ref": "#/definitions/subjMark"
        },
        {
          "$ref": "#/definitions/verbMark"
        },
        {
          "$ref": "#/definitions/endingMark"
        },
        {
          "$ref": "#/definitions/stressMark"
        },
        {
          "$ref": "#/definitions/termMark"
        },
        {
          "$ref": "#/definitions/letterMark"
        },
        {
          "$ref": "#/definitions/signalMark"
        },
        {
          "$ref": "#/definitions/soundMark"
        },
        {
          "$ref": "#/definitions/l1Mark"
        },
        {
          "$ref": "#/definitions/optionalMark"
        },
        {
          "$ref": "#/definitions/alternativesMark"
        },
        {
          "$ref": "#/definitions/examplesMark"
        },
        {
          "$ref": "#/definitions/mappingMark"
        },
        {
          "$ref": "#/definitions/takesMark"
        },
        {
          "$ref": "#/definitions/exchangeMark"
        },
        {
          "$ref": "#/definitions/glossMark"
        },
        {
          "$ref": "#/definitions/ipaMark"
        },
        {
          "$ref": "#/definitions/linkMark"
        },
        {
          "$ref": "#/definitions/dateMark"
        },
        {
          "$ref": "#/definitions/weekdayMark"
        },
        {
          "$ref": "#/definitions/timeMark"
        },
        {
          "$ref": "#/definitions/numeralMark"
        },
        {
          "$ref": "#/definitions/ordinalMark"
        },
        {
          "$ref": "#/definitions/intonationMark"
        },
        {
          "$ref": "#/definitions/gapMark"
        },
        {
          "$ref": "#/definitions/variantMark"
        },
        {
          "$ref": "#/definitions/slotMark"
        },
        {
          "$ref": "#/definitions/patternMark"
        }
      ]
    },
    "targetMark": {
      "description": "The form the topic teaches; in an error, the corrected part.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "auxMark": {
      "description": "A helper verb.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aux"
      ],
      "properties": {
        "aux": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "subjMark": {
      "description": "The subject of a pattern sentence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subj"
      ],
      "properties": {
        "subj": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "verbMark": {
      "description": "The main verb of a pattern sentence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb"
      ],
      "properties": {
        "verb": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "endingMark": {
      "description": "An ending added to a stem.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ending"
      ],
      "properties": {
        "ending": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "stressMark": {
      "description": "The stressed syllable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stress"
      ],
      "properties": {
        "stress": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "termMark": {
      "description": "A word or part of a word of the language being learned, discussed in an explanation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term"
      ],
      "properties": {
        "term": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "letterMark": {
      "description": "The letters a rule is about: the spelling of a sound, a silent letter, a capital, a spelling change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "letter"
      ],
      "properties": {
        "letter": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "signalMark": {
      "description": "A signal word inside an example.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal"
      ],
      "properties": {
        "signal": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "soundMark": {
      "description": "A pronunciation respelling.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sound"
      ],
      "properties": {
        "sound": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "l1Mark": {
      "description": "A phrase in the reader's first language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l1"
      ],
      "properties": {
        "l1": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "optionalMark": {
      "description": "An optional part.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optional"
      ],
      "properties": {
        "optional": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "alternativesMark": {
      "description": "Forms or examples that each work; the renderer joins them with a slash.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternatives"
      ],
      "properties": {
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 2
        }
      }
    },
    "examplesMark": {
      "description": "Examples side by side.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examples"
      ],
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 2
        }
      }
    },
    "mappingMark": {
      "description": "A form and what it becomes, in order. follows: the list continues the form under discussion.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping"
      ],
      "properties": {
        "mapping": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 1
        },
        "follows": {
          "const": true
        }
      }
    },
    "takesMark": {
      "description": "A case and the form it calls for. follows: the list continues the form under discussion.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "takes"
      ],
      "properties": {
        "takes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 1
        },
        "follows": {
          "const": true
        }
      }
    },
    "exchangeMark": {
      "description": "A question and its answer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchange"
      ],
      "properties": {
        "exchange": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 2
        }
      }
    },
    "glossMark": {
      "description": "A meaning in the reader's language: localized inside text of the language being learned.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gloss"
      ],
      "properties": {
        "gloss": {
          "oneOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "$ref": "#/definitions/localized"
            }
          ]
        }
      }
    },
    "ipaMark": {
      "description": "An IPA transcription, without its slashes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipa"
      ],
      "properties": {
        "ipa": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "linkMark": {
      "description": "Another topic, by ID.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link",
        "to"
      ],
      "properties": {
        "link": {
          "$ref": "#/definitions/text"
        },
        "to": {
          "$ref": "#/definitions/topicId"
        }
      }
    },
    "dateMark": {
      "description": "A date with its ISO 8601 value: 2026-07-03, --07-03, --07 or 2026.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "value"
      ],
      "properties": {
        "date": {
          "$ref": "#/definitions/text"
        },
        "value": {
          "type": "string",
          "pattern": "^(\\d{4}(-\\d\\d(-\\d\\d)?)?|--\\d\\d(-\\d\\d)?)$"
        }
      }
    },
    "weekdayMark": {
      "description": "A day of the week with its ISO 8601 number, Monday 1.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekday",
        "value"
      ],
      "properties": {
        "weekday": {
          "$ref": "#/definitions/text"
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "timeMark": {
      "description": "A clock time with its 24-hour value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "value"
      ],
      "properties": {
        "time": {
          "$ref": "#/definitions/text"
        },
        "value": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    },
    "numeralMark": {
      "description": "A number in words with its value in digits.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeral",
        "value"
      ],
      "properties": {
        "numeral": {
          "$ref": "#/definitions/text"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\d+$"
            }
          ]
        }
      }
    },
    "ordinalMark": {
      "description": "An ordinal with its value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "value"
      ],
      "properties": {
        "ordinal": {
          "$ref": "#/definitions/text"
        },
        "value": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "intonationMark": {
      "description": "The voice rises or falls.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intonation"
      ],
      "properties": {
        "intonation": {
          "enum": [
            "rise",
            "fall"
          ]
        }
      }
    },
    "gapMark": {
      "description": "An open slot or the gap in a split form.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap"
      ],
      "properties": {
        "gap": {
          "const": true
        }
      }
    },
    "variantMark": {
      "description": "The form in another variety of the language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "variety"
      ],
      "properties": {
        "variant": {
          "$ref": "#/definitions/text"
        },
        "variety": {
          "$ref": "#/definitions/variety"
        }
      }
    },
    "slotMark": {
      "description": "A slot of a pattern: a code from the slot list, or a description of what fills it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot"
      ],
      "properties": {
        "slot": {
          "oneOf": [
            {
              "enum": [
                "V",
                "V-s",
                "V-ing",
                "V-ed",
                "-ing",
                "subject",
                "verb",
                "base verb",
                "noun",
                "plural noun",
                "singular noun",
                "uncountable noun",
                "adjective",
                "adverb",
                "comparative",
                "superlative",
                "wh-word",
                "person",
                "clause",
                "past participle",
                "infinitive",
                "present",
                "past",
                "past simple",
                "number",
                "unit",
                "hyphen",
                "result",
                "agent",
                "helper",
                "consonant",
                "vowel",
                "the time",
