{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "curriculum.schema.json",
  "title": "langs123 curriculum",
  "description": "Every planned topic of every language being learned: sections by category, and the study path by level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "languages"
  ],
  "properties": {
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "enabled",
          "slug",
          "name",
          "sections",
          "path"
        ],
        "properties": {
          "code": {
            "enum": [
              "en"
            ]
          },
          "enabled": {
            "type": "boolean",
            "description": "false keeps the language from readers; its data stays and is still checked"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z]+$",
            "description": "URL segment of the language being learned"
          },
          "name": {
            "$ref": "#/definitions/localized"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dir",
                "title",
                "topics"
              ],
              "properties": {
                "dir": {
                  "type": "string",
                  "pattern": "^\\d\\d-[a-z0-9-]+$"
                },
                "title": {
                  "$ref": "#/definitions/localized"
                },
                "topics": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "slug"
                    ],
                    "properties": {
                      "slug": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      },
                      "levels": {
                        "type": "string",
                        "pattern": "^(A0|A1|A2|B1|B2|C1|C2)(-(A0|A1|A2|B1|B2|C1|C2))?$",
                        "description": "Planned range of a topic without a topic file; a written topic takes its range from its data."
                      },
                      "title": {
                        "$ref": "#/definitions/localized"
                      }
                    }
                  }
                }
              }
            },
            "description": "Topics by category; the menu's Categories order."
          },
          "path": {
            "type": "object",
            "description": "The study path: per level, lowest first, the topics to study at that level, in order. A topic comes back at each level where it grows.",
            "propertyNames": {
              "$ref": "#/definitions/level"
            },
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9-]+\\.[a-z0-9-]+$",
                "description": "Topic ID: {lang}.{section}.{topic}"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "level": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string"
        }
      }
    }
  }
}
