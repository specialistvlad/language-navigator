{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site identity and explanation languages",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "url", "repository", "explain"],
  "properties": {
    "name": { "type": "string" },
    "url": { "description": "Public URL, without a trailing slash.", "type": "string", "pattern": "^https://[^ ]+[^/]$" },
    "repository": { "type": "string", "pattern": "^https://[^ ]+[^/]$" },
    "explain": {
      "description": "Explanation languages, in display order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{2}$" },
          "name": {
            "description": "The language's name in every explanation language; name[code] is its own name.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
