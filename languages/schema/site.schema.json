{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site identity, licences and explanation languages",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "url",
    "repository",
    "credit",
    "licences",
    "explain"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "description": "Public URL, without a trailing slash.",
      "type": "string",
      "pattern": "^https://[^ ]+[^/]$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://[^ ]+[^/]$"
    },
    "credit": {
      "description": "How every reuse of the content names its authors.",
      "type": "string",
      "minLength": 1
    },
    "licences": {
      "description": "The content licence covers languages/; the code licence covers everything else.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "code"
      ],
      "properties": {
        "content": {
          "$ref": "#/definitions/licence"
        },
        "code": {
          "$ref": "#/definitions/licence"
        }
      }
    },
    "explain": {
      "description": "Explanation languages, in display order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "enabled",
          "name"
        ],
        "properties": {
          "code": {
            "$ref": "#/definitions/explain"
          },
          "enabled": {
            "description": "false keeps the language from readers; its data stays and is still checked.",
            "type": "boolean"
          },
          "name": {
            "$ref": "#/definitions/localized"
          }
        }
      }
    }
  },
  "definitions": {
    "explain": {
      "enum": [
        "en"
      ]
    },
    "localized": {
      "description": "Text in every explanation language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        }
      }
    }
  }
}
